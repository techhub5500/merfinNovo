# ========================================
# CONFIGURAÇÃO DE AMBIENTE - Merfin.IA
# ========================================
# Copie este arquivo para .env e preencha com suas credenciais

# ========== BANCO DE DADOS ==========
# MongoDB Atlas Connection String
# Obtenha em: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/merfin?retryWrites=true&w=majority

# ========== AUTENTICAÇÃO ==========
# Chave secreta para JWT (use uma string aleatória e segura)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=sua_chave_secreta_super_segura_aqui

# ========== OPENAI API ==========
# Chave da API OpenAI para o Merfin Agent
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== STRIPE PAGAMENTOS ==========
# Chaves da API Stripe (use Test Keys para desenvolvimento)
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook Secret do Stripe (gerado ao criar webhook)
# Obtenha em: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxx

# IDs dos Preços/Planos (Price IDs do Stripe)
# Obtenha em: https://dashboard.stripe.com/prices
STRIPE_PRICE_ID_BASICO=price_xxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_PREMIUM=price_xxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_EMPRESARIAL=price_xxxxxxxxxxxxxxxxxx

# ========== CONFIGURAÇÃO DOS SERVIDORES ==========
# Porta do servidor operacional (padrão: 5000)
PORT=5000

# Porta do servidor agent (padrão: 5001)
AGENT_PORT=5001

# URL do servidor operacional (para o agent se comunicar)
# Desenvolvimento: http://localhost:5000
# Produção: https://merfin-operacional.onrender.com
OPERATIONAL_SERVER_URL=http://localhost:5000

# ========== OPCIONAL - PESQUISA WEB ==========
# API Key do Serper (Google Search API)
# Obtenha em: https://serper.dev
# Se não configurar, a pesquisa web será desabilitada
SEARCH_API_KEY=seu_serper_api_key_aqui

# ========== AMBIENTE ==========
# Ambiente de execução (development, production)
NODE_ENV=development
